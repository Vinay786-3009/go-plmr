rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    function isUnder10MB() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Driver Verification Documents (DL, RC, Insurance, Profile Photo)
    match /drivers/{driverId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == driverId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == driverId && isImageOrPdf() && isUnder10MB();
    }

    // Helmet Verification Selfies
    match /helmetEvidence/{rideId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isImageOrPdf() && isUnder10MB();
    }

    // Admin-only assets
    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
