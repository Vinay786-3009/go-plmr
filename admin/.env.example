# Go Plmr Admin Panel - Environment Variables Example
# Replace with your actual Firebase Web API Key for the 'go-plmr' project
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY

# Optional: Set the Realtime Database URL if created in Firebase console
# Default region: us-central1 or asia-southeast1 (e.g., https://go-plmr-default-rtdb.firebaseio.com)
VITE_FIREBASE_DATABASE_URL=
